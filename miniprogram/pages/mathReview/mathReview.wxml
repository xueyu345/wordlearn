<view class="page">
  <view class="mode-top">
    <view class="back-btn" bindtap="onBack">←</view>
    <view class="mode-title">
      <text class="mode-name">{{title}}</text>
      <text class="muted">{{sub}}</text>
    </view>
    <view class="mode-count">{{progressText}}</view>
  </view>

  <view class="bar bar-slim">
    <view class="bar-inner" style="width:{{barWidth}}%"></view>
  </view>

  <view class="card review-card">
    <!-- 结算 -->
    <view class="review-result" wx:if="{{finished}}">
      <view class="result-emoji">{{result.emoji}}</view>
      <view class="h2">{{result.title}}</view>
      <text class="muted">{{result.desc}}</text>
      <view class="form-actions">
        <view class="btn btn-primary" bindtap="onAgain">再练一轮</view>
        <view class="btn btn-soft" bindtap="onBack">回到错题本</view>
      </view>
    </view>

    <!-- 答题 -->
    <block wx:else>
      <view class="review-head">
        <text class="pill pill-purple">{{kp}}</text>
        <text class="pill pill-blue">{{type}}</text>
      </view>

      <view class="review-question">{{q}}</view>

      <view class="thumbs review-images" wx:if="{{hasImages}}">
        <view class="thumbs-item" wx:for="{{images}}" wx:for-item="img" wx:key="*this">
          <image class="thumb" src="{{img}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewImage"></image>
        </view>
      </view>

      <view class="review-block" wx:if="{{showMyAnswer}}">
        <text class="review-label">我当时写的</text>
        <view class="review-text">{{myAnswer}}</view>
      </view>

      <view class="review-answer-box" wx:if="{{showAnswer}}">
        <text class="review-label">正确答案</text>
        <view class="review-text strong">{{a}}</view>
        <view class="review-block" wx:if="{{showWhy}}">
          <text class="review-label">错在哪</text>
          <view class="review-text">{{why}}</view>
        </view>
        <view class="review-block" wx:if="{{showSteps}}">
          <text class="review-label">解题步骤</text>
          <view class="step-row" wx:for="{{steps}}" wx:key="key">
            <text class="step-no">{{index + 1}}</text>
          <text class="step-text">{{item.text}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="btn btn-primary btn-block" wx:if="{{showReveal}}" bindtap="onReveal">👀 先自己做一遍，再看答案</view>

    <view class="review-judge" wx:if="{{showJudge}}">
      <view class="judge-tip">这次做对了吗？</view>
      <view class="judge-actions">
        <view class="btn btn-soft" bindtap="onMissed">😅 还是没做对</view>
        <view class="btn btn-primary" bindtap="onGot">✅ 这次做对了</view>
      </view>
    </view>
  </view>
</view>
