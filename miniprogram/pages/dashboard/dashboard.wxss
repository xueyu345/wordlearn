/* ---------- 快捷入口 ---------- */
.dash-quick { margin-bottom: 24rpx; }

.dash-quick-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(103, 76, 40, .08);
}
.dash-quick-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.q-en .dash-quick-ico { background: var(--purple-soft); }
.q-math .dash-quick-ico { background: #E3F8F5; }
.q-solve .dash-quick-ico { background: #FFEEDC; }

.dash-quick-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.dash-quick-main .tiny { line-height: 1.35; }
.dash-quick-go { color: var(--purple); font-weight: 800; font-size: 26rpx; flex: none; }

/* ---------- 今日目标环形进度 ---------- */
.dash-goal-card { display: flex; align-items: center; gap: 28rpx; }

.dash-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--line);
  flex: none;
}
.dash-ring-half {
  position: absolute;
  top: 0;
  width: 100rpx;
  height: 200rpx;
  overflow: hidden;
  z-index: 1;
}
.half-left { left: 0; }
.half-right { left: 100rpx; }
.dash-ring-semi {
  position: absolute;
  top: 0;
  width: 100rpx;
  height: 200rpx;
  border-radius: 0 100rpx 100rpx 0;
  background: linear-gradient(160deg, #FFC93C, var(--orange));
  transform-origin: 0% 50%;
}
.half-left .dash-ring-semi { left: 100rpx; }
.half-right .dash-ring-semi { left: 0; }

.dash-ring-inner {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #fff;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.dash-ring-num { font-size: 54rpx; font-weight: 800; line-height: 1; color: var(--orange-deep); }
.dash-ring-den { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }

.dash-goal-side { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.dash-goal-meta { display: flex; flex-wrap: wrap; gap: 8rpx; }
.dash-goal-meta .pill { height: 44rpx; padding: 0 16rpx; }

/* ---------- 概览四宫格 ---------- */
.dash-stats { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 8rpx; }
.dash-stat {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: #FBF7F0;
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
}
.dash-stat-value { display: flex; align-items: baseline; }
.dash-stat-num { font-size: 40rpx; font-weight: 800; }
.dash-stat-unit { font-size: 22rpx; color: var(--muted); margin-left: 4rpx; }
.dash-stat-label { font-size: 24rpx; font-weight: 700; margin-top: 4rpx; }
.dash-stat-sub { font-size: 20rpx; color: var(--muted); }

/* ---------- 柱状图 ---------- */
.dash-trend {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  margin-top: 16rpx;
  gap: 4rpx;
}
.dash-bar-col {
  flex: 1;
  min-width: 0;
  height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.dash-bar-value { font-size: 18rpx; color: var(--muted); height: 24rpx; line-height: 24rpx; }
.dash-bar {
  width: 24rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #C9BDF6;
}
.dash-bar.zero { background: #EFE7DB; }
.dash-bar.today { box-shadow: 0 0 0 4rpx rgba(255, 138, 61, .18); }
.dash-bar-label { font-size: 16rpx; color: var(--muted); margin-top: 6rpx; height: 24rpx; line-height: 24rpx; }

/* ---------- 进度条列表 ---------- */
.dash-bars { margin-top: 16rpx; }
.dash-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.dash-line-name {
  width: 190rpx;
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dash-track {
  flex: 1;
  min-width: 0;
  height: 16rpx;
  border-radius: 99rpx;
  background: #F1E9DE;
  overflow: hidden;
}
.dash-fill {
  height: 100%;
  border-radius: 99rpx;
  background: var(--purple);
  transition: width .4s ease;
}
.dash-line-pct { width: 90rpx; flex: none; text-align: right; font-size: 22rpx; color: var(--muted); }

/* ---------- 数学错题 ---------- */
.dash-math-top { display: flex; gap: 12rpx; margin-bottom: 8rpx; }
.dash-math-box {
  flex: 1;
  background: #E3F8F5;
  border-radius: 18rpx;
  padding: 16rpx 4rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
}
.dash-math-num { font-size: 34rpx; font-weight: 800; color: #12897C; }

.dash-actions { margin-top: 12rpx; }
.dash-link { color: var(--purple); font-size: 26rpx; font-weight: 700; }

/* ---------- 易错词 ---------- */
.dash-weak { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.dash-weak-chip {
  background: #FDEAEC;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
}
.dash-weak-w { font-size: 26rpx; font-weight: 800; color: var(--red); }
.dash-weak-zh { font-size: 20rpx; color: var(--muted); }
.dash-weak-n { font-size: 20rpx; color: var(--red); }

/* ---------- 徽章 ---------- */
.dash-badges { display: flex; flex-wrap: wrap; gap: 12rpx; }
.dash-badges .badge { width: auto; flex: 0 0 calc(25% - 9rpx); box-sizing: border-box; }
