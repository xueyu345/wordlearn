/* 英语单词主页 */

/* ---------- Hero ---------- */
.hero {
  position: relative;
  background: linear-gradient(140deg, #FFB054, #FF8A3D 55%, #F0701C);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 40rpx;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(240, 112, 28, .28);
  margin-bottom: 24rpx;
  overflow: hidden;
}
.hero-eyebrow {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  opacity: .95;
}
.hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 99rpx;
  background: #FFF;
  margin-right: 12rpx;
}
.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.25;
  margin: 16rpx 0 12rpx;
  letter-spacing: 2rpx;
}
.hero-title-block { display: block; }
.hero-desc { font-size: 24rpx; line-height: 1.6; opacity: .95; }
.hero-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.hero-actions .btn { height: 76rpx; font-size: 26rpx; padding: 0 26rpx; }
.btn-white { background: #fff; color: #F0701C; box-shadow: 0 6rpx 0 rgba(0, 0, 0, .06); }
.btn-ghost-light { background: rgba(255, 255, 255, .22); color: #fff; box-shadow: none; }
.hero-mascot {
  position: absolute;
  right: 26rpx;
  bottom: 10rpx;
  font-size: 110rpx;
  opacity: .9;
}

/* ---------- 统计三块 ---------- */
.stats { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 12rpx; }
.panel {
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(103, 76, 40, .08);
}
.panel-icon { font-size: 56rpx; margin-right: 22rpx; }
.panel-copy { flex: 1; min-width: 0; }
.panel-kicker { display: block; font-size: 22rpx; color: #8B7F9B; font-weight: 700; }
.panel-h3 { font-size: 32rpx; font-weight: 800; margin: 4rpx 0; }
.panel-p { font-size: 23rpx; color: #8B7F9B; }
.bar-slim { height: 12rpx; margin-top: 14rpx; }

.goal-ring {
  width: 130rpx;
  height: 130rpx;
  border-radius: 99rpx;
  background: #FFF1DF;
  border: 8rpx solid #FFD9A8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.goal-num { font-size: 46rpx; font-weight: 900; color: #F0701C; line-height: 1; }
.goal-den { font-size: 22rpx; color: #B98A5C; font-weight: 700; }

/* ---------- 本周打卡圆点 ---------- */
.week-dots { display: flex; gap: 10rpx; margin-top: 12rpx; }
.day-dot {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dot-face {
  width: 40rpx;
  height: 40rpx;
  border-radius: 99rpx;
  background: #F1E9DE;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.day-dot.done .dot-face { background: linear-gradient(135deg, #5FD8C8, #27B8A8); }
.day-dot.today .dot-face { box-shadow: 0 0 0 4rpx #FFE2B8; }
.dot-label { font-size: 20rpx; color: #8B7F9B; margin-top: 6rpx; }

/* ---------- 今日推荐 ---------- */
.daily-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 3rpx solid transparent;
}
.daily-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.daily-emoji { font-size: 76rpx; margin-right: 22rpx; }
.daily-copy { flex: 1; min-width: 0; }
.daily-go { font-size: 26rpx; font-weight: 800; color: #7057F5; }

/* ---------- 玩法 ---------- */
.mode-wrap { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 12rpx; }
.mode-card {
  display: flex;
  align-items: center;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
}
.mode-icon { font-size: 52rpx; margin-right: 20rpx; }
.mode-info { flex: 1; min-width: 0; }
.mode-name { font-size: 30rpx; font-weight: 800; }
.mode-desc { font-size: 22rpx; color: #8B7F9B; margin-top: 2rpx; }
.mode-arrow { font-size: 30rpx; color: #B3A8C4; font-weight: 800; }

/* ---------- 主题卡片 ---------- */
.unit-hint { display: block; margin: -8rpx 0 18rpx; }
.unit-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.unit-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  border-radius: 26rpx;
  padding: 24rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 20rpx rgba(103, 76, 40, .07);
}
.unit-top { display: flex; align-items: center; justify-content: space-between; }
.unit-emoji { font-size: 52rpx; }
.unit-count {
  font-size: 20rpx;
  font-weight: 800;
  color: #fff;
  background: rgba(52, 43, 69, .25);
  border-radius: 99rpx;
  padding: 4rpx 14rpx;
}
.unit-name { font-size: 30rpx; font-weight: 800; margin-top: 10rpx; }
.unit-en { font-size: 21rpx; color: #7A6E8A; margin-top: 2rpx; }
.unit-progress { margin-top: 16rpx; }
.unit-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #7A6E8A;
  margin-top: 10rpx;
}

/* ---------- 混合大挑战 ---------- */
.mixed-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(120deg, #8A72FF, #7057F5);
  border-radius: 26rpx;
  padding: 28rpx;
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(112, 87, 245, .28);
  margin-bottom: 24rpx;
}
.mixed-emoji { font-size: 60rpx; margin-right: 20rpx; }
.mixed-copy { flex: 1; min-width: 0; font-size: 30rpx; }
.mixed-small { font-size: 22rpx; opacity: .9; margin-top: 4rpx; }
.mixed-go { font-size: 26rpx; font-weight: 800; }

/* ---------- 错词 ---------- */
.wrong-card { margin-bottom: 24rpx; }
.wrong-emoji { font-size: 64rpx; }
.wrong-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.wrong-actions .btn { flex: 1; }

/* ---------- 小贴士 ---------- */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: #FFF6E2;
  border-radius: 22rpx;
  padding: 24rpx;
}
.tip-icon { font-size: 40rpx; margin-right: 16rpx; }
.tip-text { flex: 1; font-size: 23rpx; line-height: 1.7; color: #6B5A3C; }
