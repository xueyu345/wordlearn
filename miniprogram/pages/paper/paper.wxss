/* 错题试卷 */
.paper-block {
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 22rpx 22rpx 4rpx;
  margin-bottom: 22rpx;
  background: #FFFCF6;
}
.paper-block.is-off { opacity: .55; }

.paper-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.paper-switch-title { font-size: 28rpx; font-weight: 800; }

.paper-note { display: block; color: var(--muted); line-height: 1.7; margin-bottom: 20rpx; }

.paper-sheet { padding: 26rpx; }
.paper-head { margin-bottom: 12rpx; }
.paper-head-copy { flex: 1; min-width: 0; }
.paper-head-copy .muted { display: block; margin-top: 6rpx; line-height: 1.6; }

.paper-info { display: flex; gap: 32rpx; font-size: 24rpx; color: var(--muted); margin-top: 14rpx; }

.paper-score { display: flex; gap: 14rpx; margin-top: 20rpx; }
.paper-score-card {
  flex: 1;
  background: #FFF8EC;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.paper-score-num { display: block; font-size: 34rpx; font-weight: 800; }
.paper-score-num.green { color: var(--green); }
.paper-score-num.red { color: var(--red); }
.paper-score-card .tiny { display: block; margin-top: 4rpx; }

.paper-sec { margin-top: 26rpx; }
.paper-sec .h2 { margin-bottom: 4rpx; }

.paper-q { padding: 20rpx 0; border-bottom: 2rpx dashed var(--line); }
.paper-q-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.paper-q-num {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--purple-soft);
  color: var(--purple);
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.paper-q-stem { font-size: 30rpx; line-height: 1.7; }
.paper-q-tip { display: block; margin-top: 6rpx; }

.paper-q-answer { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.paper-q-label { font-size: 26rpx; color: var(--muted); flex-shrink: 0; }
.paper-input { flex: 1; min-height: 72rpx; padding: 0 20rpx; }
.paper-q-mark { width: 40rpx; text-align: center; font-size: 28rpx; flex-shrink: 0; }

.paper-q.ok .paper-input { border-color: #BFE6D2; background: #F5FCF8; }
.paper-q.no .paper-input { border-color: #F0C4C8; background: #FFF6F6; }

.paper-q-std { display: block; margin-top: 10rpx; color: var(--muted); }

.paper-foot { display: block; margin-top: 24rpx; line-height: 1.7; }
